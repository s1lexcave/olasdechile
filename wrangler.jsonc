{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olasdechile",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "olasdechile-db",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
